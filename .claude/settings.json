{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__github__create_pull_request|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/ship-next-guard.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking ship-next workflow"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/session-notice.sh\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}