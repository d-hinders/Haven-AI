# Haven — DEV environment variables (template)
#
# The single shared dev environment (one `dev` branch → one Railway/Vercel deploy).
# Mirrors .env.example with dev-isolated values. Set these in the dev Railway
# project (backend / mcp-server) and the dev Vercel project (frontend) — never in
# code. Every secret here MUST differ from production.
#
# Key isolation rules:
#   - Separate Postgres from prod (payment product — never share a DB).
#   - Dev-only JWT_SECRET and RELAYER_PRIVATE_KEY (cross-env token confusion + no
#     real funds at risk).
#   - Prefer TESTNETS for dev RPC so WIP code can't move real funds on mainnet.

# Backend
PORT=3001
# Dev Postgres — a separate Railway managed instance, NOT the prod DB.
DATABASE_URL=postgresql://haven:haven@dev-postgres-host:5432/haven_dev

# Blockchain — prefer testnets for dev (Gnosis Chiado + Base Sepolia).
# Swap to mainnet RPCs only if a test genuinely needs mainnet state.
RPC_URL=https://rpc.chiadochain.net
RPC_URL_BASE=https://sepolia.base.org
# Base Sepolia (84532) is now a first-class chain — create dev/QA agents on
# chain_id 84532 (correct testnet contract and USDC addresses), NOT
# chain_id 8453 with a Sepolia RPC (mainnet contract addresses don't exist on
# Sepolia). RPC_URL_BASE above (for 8453) feeding a Sepolia RPC is a mismatch.
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Chains this environment serves account *deploys* on (#679). Onboarding and the
# Add-account modal only offer these, and a non-served chain is rejected with a
# clear message instead of a confusing "relayer temporarily unfunded". Comma-
# separated; UNSET = all supported (backward-compatible). Dev serves Base Sepolia
# only; prod sets `8453,84532` (once the prod Sepolia relayer is funded).
HAVEN_DEPLOY_CHAIN_IDS=84532

# Auth — dev-only secret, must differ from prod.
JWT_SECRET=generate_a_dev_only_secret

# APIs (can reuse prod keys or use separate dev keys)
GNOSISSCAN_API_KEY=your_api_key_from_gnosisscan.io
BASESCAN_API_KEY=your_api_key_from_basescan.org
COINGECKO_API_KEY=your_api_key_from_coingecko.com

# Frontend — point at the dev backend / dev mcp-server, dev WalletConnect project.
# The dev frontend has NO permanent URL — it's a per-PR Vercel preview link that
# changes on every deployment; FRONTEND_URL only feeds backend-built links (e.g.
# the Fortnox redirect). Set it to the current preview URL when one is needed.
# CONFIRM the dev frontend URL in Vercel — haven-dev.vercel.app is a DIFFERENT app
# ("HAVEN Project" Vite SPA), not Haven's Next.js dashboard.
#
# NOTE: there are TWO Railway backends — the LIVE dev one is havenbackend-dev-8b95
# (verified). `dev-backend.up.railway.app` is a STALE DUPLICATE that still responds
# with ~24-day-old code; do NOT use it (it caused real confusion — see #585/#595).
FRONTEND_URL=https://CONFIRM-dev-frontend.vercel.app
NEXT_PUBLIC_API_URL=https://havenbackend-dev-8b95.up.railway.app
# Confirmed 2026-08-06 (#1131): the dev hosted MCP host. Sleeps when idle —
# first call after a quiet period cold-starts. The BACKEND needs the same value
# in HAVEN_HOSTED_MCP_URL below — that is the one the connector writes into an
# agent's runtime config.
NEXT_PUBLIC_HAVEN_MCP_URL=https://haven-ai-hosted-mcp-dev-25c7.up.railway.app/v1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_dev_walletconnect_project_id
# Shows the "DEV" badge in the app header (see components/EnvBadge.tsx).
NEXT_PUBLIC_HAVEN_ENV=dev
# Default onboarding chain (#615). Dev sets 84532 so new accounts default to Base
# Sepolia (testnet); prod leaves it unset → Base mainnet (8453). Both chains stay
# selectable (#622). ⚠️ MUST be set in the Vercel **Preview** scope too — a PR
# preview without it defaults onboarding to mainnet and hits the testnet-only
# relayer ("relayer unfunded").
NEXT_PUBLIC_HAVEN_CHAIN_ID=84532

# Haven API URL (scripts / mcp-server / demo-merchant → internal dev backend URL)
# ⚠️ On the dev hosted-MCP service this was set to a NON-EXISTENT host for weeks
# (`havenbackend-dev-8a00` — the dev prefix with production's hash), so every
# relayed call failed upstream. Verify it resolves before trusting the service.
HAVEN_API_URL=https://havenbackend-dev-8b95.up.railway.app

# Hosted MCP URL the BACKEND hands to the connector at setup time (#1129).
# Must match NEXT_PUBLIC_HAVEN_MCP_URL above. Unset → the backend falls back to
# the production hosted MCP and dev agents get 401 "Invalid or revoked API key",
# because the prod MCP resolves their key against the prod database.
HAVEN_HOSTED_MCP_URL=https://haven-ai-hosted-mcp-dev-25c7.up.railway.app/v1

# Dev demo-merchant — x402 settlement target for QA (#575). Verified online.
# For testnet QA the merchant service itself must run on Base Sepolia: set
# MERCHANT_CHAIN_ID=84532 + BASE_RPC_URL=https://sepolia.base.org + a Sepolia
# gas-funded SETTLEMENT_PRIVATE_KEY on its Railway service (see #604). Without
# that it demands Base mainnet USDC and the Base Sepolia QA delegate can't pay.
QA_DEMO_MERCHANT_URL=https://demo-merchant-dev-84e4.up.railway.app
# Backend dev only: make the #2159 crash/resume QA leg deterministic after its
# funding transaction confirms. Startup refuses this on any deployment other
# than HAVEN_DEPLOY_CHAIN_IDS=84532; production always retains its 15-minute
# recovery grace window.
MERCHANT_REPORT_GRACE_MIN_OVERRIDE=0
# Demo-merchant service only: the QA sweep scenario buys this product to create
# a deterministic verified-but-unsettled delegate balance, then reclaims it.
MERCHANT_SKIP_SETTLE_PRODUCT=storage_50gb

# ── Experimental ERC-7710 rail on the dev demo-merchant (#747/#752, epic #452) ──
# OFF by default, and this file is documentation of the service's variables, not
# applied config: the code auto-deploys from `dev`, the variables do not. Turning
# the rail on is a manual change on the Railway demo-merchant service.
#
# ⚠️ SET BOTH TOGETHER. The flag without a valid manager address makes the
# service EXIT AT STARTUP by design — on Railway that is a crash-loop until the
# second variable lands.
#
# TESTNET-ONLY: startup also refuses the flag on any chain other than
# MERCHANT_CHAIN_ID=84532, so mainnet can never advertise erc7710. Do NOT add
# these to the production merchant service.
#
# The manager must be HAVEN'S OWN pinned DelegationManager, not whatever is
# currently top of MetaMask's published list — the address is version-specific
# and a mismatch fails every real Haven-agent payment to this merchant.
# Base Sepolia: 0xdb9B1e94B5b69Df7e401DDbedE43491141047dB3 (see
# packages/backend/src/lib/delegation-contracts.ts, from smart-accounts-kit
# 1.6.0). Delegations naming any other manager are rejected before simulation.
#
# No new keys are needed: the service's existing SETTLEMENT_PRIVATE_KEY account
# is the redeemer, so a redeemer caveat must name that address. To disable
# again, unset the flag alone.
#
# Full runbook: docs/operations/dev-environment.md § demo-merchant.
# MERCHANT_X402_ERC7710=1
# MERCHANT_ERC7710_DELEGATION_MANAGER=0xdb9B1e94B5b69Df7e401DDbedE43491141047dB3

# Relayer — DEV EOA, funded with minimal testnet gas. Never the prod relayer key.
# Generate one: node -e "const{ethers}=require('ethers');const w=ethers.Wallet.createRandom();console.log('Address:',w.address);console.log('Key:',w.privateKey)"
RELAYER_PRIVATE_KEY=your_dev_relayer_private_key
# Per-chain relayer override (#640/#678): RELAYER_PRIVATE_KEY_<chainId> is the key
# that submits relayed transactions on that chain — delegator activation, passport
# attestations, sweeps and owner-signed Safe `exec` relays — falling back to the
# global key above. Dev's global key is already a testnet key, so no
# override is needed here. PROD uses this to run an ISOLATED, testnet-only Base
# Sepolia relayer (RELAYER_PRIVATE_KEY_84532, funded on Sepolia only) that can
# never touch the mainnet relayer's funds — extending the dev/prod isolation (#613).
# RELAYER_PRIVATE_KEY_84532=a_dedicated_testnet_only_relayer_key

# Sweep recovery floor in USDC (#700, recalibrated #2293). Production defaults to
# 0.01; dev sets 0 so the QA sweep scenario (strands 0.0005) still exercises a
# real gasless sweep instead of being left below the floor.
# Makes dev hand out the DEV connector (#2422, epic #2420) so a developer
# testing against this backend installs @haven_ai/connect@dev and its pinned dev
# signer, not the production package set. Production leaves this unset (=> alpha).
# NOT YET SET on the deployed dev backend — this template is what the value
# SHOULD be, and setting it is an owner step. It requires at least one @dev
# snapshot on npm (slice 1, #2421) first, or npx cannot resolve the tag.
HAVEN_CONNECTOR_CHANNEL=dev

SWEEP_MIN_USDC=0

# Fortnox bookkeeping integration (optional — disabled unless all three are set).
# Use a separate dev Fortnox app + redirect if testing the feed on dev.
FORTNOX_CLIENT_ID=your_dev_fortnox_client_id
FORTNOX_CLIENT_SECRET=your_dev_fortnox_client_secret
FORTNOX_REDIRECT_URI=https://havenbackend-dev-8b95.up.railway.app/accounting/fortnox/callback

# Feature flags — keep dark unless a dev test exercises them (same defaults as prod).
CATALOG_DISCOVERY_ENABLED=false
HAVEN_FEE_ENABLED=false
HAVEN_LEGACY_BOOKKEEPING_ENABLED=false
HAVEN_HOSTED=false
HAVEN_REPORTING_FEED_ENABLED=false

# Delegation rail (the base for new accounts — fail-closed when unset).
# The bundler URL is CHAIN-SCOPED by its path: /v2/84532/ serves Base Sepolia
# only; a deployment holding this URL cannot serve mainnet (see
# docs/operations/delegation-rail-vendor-ops.md §2).
# DELEGATION_RAIL_BUNDLER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=...
# DELEGATION_RAIL_SPONSORSHIP_POLICY_ID=sp_...

# #1670: trusted proxy hops in front of the backend. Railway terminates in one
# edge proxy, so set 1 there; leave unset (0) for direct/local serving. This is
# what arms the per-IP auth rate limits — they deliberately stay OFF while the
# proxy is untrusted, because a shared-bucket limit on signup/login is a global
# denial-of-service, not a protection. A hop COUNT, never `true`: see config.ts.
# Operator-owned; never flipped by an agent. Before flipping in a NEW
# environment, verify the hop count empirically: log request.ip together with
# the raw x-forwarded-for header for a few real requests — with the right
# count, request.ip is the CLIENT, not an intermediate proxy.
TRUST_PROXY_HOPS=1

# #1690: emit the payer identity in x402 expected contexts (version 3). SIGNER-
# FIRST rollout: leave unset until the connector population runs a signer that
# supports context version 3 — a v1/v2 signer refuses v3 with the version-skew
# message, which is honest but blocks payments. Operator-owned; never flipped
# by an agent. When unset the wire is byte-identical to pre-#1690 (version 2).
# NOTE: read per call, so a mid-rollout flip can make two fetches of the SAME
# payment disagree on context version (authorize v3, sign-context v2) — flip
# between payments, not during one.
# X402_EMIT_PAYER_CONTEXT=1
