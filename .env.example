# Backend
PORT=3001
DATABASE_URL=postgresql://haven:haven@localhost:5432/haven
# Log verbosity (pino levels: trace|debug|info|warn|error|fatal|silent). Default: info.
# LOG_LEVEL=info
# Postgres pool tuning (optional — sensible defaults if unset).
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECTION_TIMEOUT=5000

# Blockchain
RPC_URL=https://rpc.gnosischain.com
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Chains this environment serves account deploys on (#679). Comma-separated;
# UNSET = all supported. Onboarding offers only these and a non-served chain is
# rejected with a clear message instead of a confusing "relayer unfunded".
# Prod: 8453,84532 (once a Sepolia relayer is funded); dev: 84532.
# HAVEN_DEPLOY_CHAIN_IDS=8453,84532

# x402 funded-but-unsettled recovery grace (#2159). Leave unset in production:
# the server always retains its 15-minute window there. Dev QA may set this to
# an integer from 0 to 15 only when HAVEN_DEPLOY_CHAIN_IDS is exactly 84532.
# MERCHANT_REPORT_GRACE_MIN_OVERRIDE=0

# Delegation rail bundler (#826, epic #821). SECRET — hosted bundler URLs embed
# the API key. REQUIRED for the delegation rail (fail-closed if unset). The
# legacy SESSION_RAIL_BUNDLER_URL fallback was removed after both environments
# migrated (#882). Sponsorship policy binds PER REQUEST (the #738 lesson).
# DELEGATION_RAIL_BUNDLER_URL=https://api.pimlico.io/v2/84532/rpc?apikey=...
# DELEGATION_RAIL_SPONSORSHIP_POLICY_ID=sp_...

# Auth
JWT_SECRET=change_me_in_production

# APIs
GNOSISSCAN_API_KEY=your_api_key_from_gnosisscan.io
BASESCAN_API_KEY=your_api_key_from_basescan.org
COINGECKO_API_KEY=your_api_key_from_coingecko.com

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Hosted MCP endpoint for THIS environment (#1129) — the URL agents' MCP
# clients get pointed at. The production endpoint is a built-in default ONLY
# when the deployment itself is production (backend: self-URL is the prod
# host; frontend: prod build). REQUIRED outside production: a dev or local
# deployment without these fails setup loudly (backend 500 naming the
# variable; dashboard shows a not-configured state) instead of silently
# handing out production's URL — a dev-issued agent key sent to the prod
# hosted MCP just 401s. Local development can skip both and connect agents
# with the local connector (`--local`).
# Frontend, build-time inlined — used by the dashboard connect snippets:
# NEXT_PUBLIC_HAVEN_MCP_URL=https://this-environments-hosted-mcp/v1
# Backend — handed to the connector at setup time. Falls back to
# NEXT_PUBLIC_HAVEN_MCP_URL before the production-only default applies:
# HAVEN_HOSTED_MCP_URL=https://this-environments-hosted-mcp/v1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_from_cloud.walletconnect.com
# Environment indicator. Leave unset (or "production") on prod; set to "dev" on
# the dev deploy to show a "DEV" badge in the app header. Build-time inlined.
# NEXT_PUBLIC_HAVEN_ENV=
# Default onboarding chain (#615). Unset → Base mainnet (8453); set to 84532 to
# default new accounts to Base Sepolia (the dev deploy does this). Both chains
# stay selectable (#622). Build-time inlined — set per Vercel scope.
# NEXT_PUBLIC_HAVEN_CHAIN_ID=

# Haven API URL (backend runs on this port).
#
# Read by scripts AND by the backend, for absolute links it hands out. On a
# DEPLOYED backend, set it: without it the x402 settle response omits the
# passport `verify_url` entirely (#976) rather than guessing a base from the
# request's Host header, which a caller controls. `PUBLIC_API_URL` is a legacy
# alias for the same value. Omitting it degrades a convenience link, never the
# reference itself — `attestation_uid` + `chain_id` always ship.
HAVEN_API_URL=http://localhost:3001

# Relayer — EOA that pays gas for agent transactions (needs small xDAI balance)
# Generate one: node -e "const{ethers}=require('ethers');const w=ethers.Wallet.createRandom();console.log('Address:',w.address);console.log('Key:',w.privateKey)"
RELAYER_PRIVATE_KEY=your_relayer_private_key

# ── L0 Agent Passport (epic #970, #971) ──────────────────────────────────────
# The EAS schema UID, per chain, recorded AFTER an operator registers the schema
# (`npm run ops:register-passport-schema -w packages/backend -- --send`). Unset
# means "not registered on this chain": issuance refuses fail-closed rather than
# attesting against a schema nobody can verify.
# AGENT_PASSPORT_SCHEMA_UID_84532=0x...
#
# Throwaway testnet key used ONLY for the one-off schema registration above.
# Never reuse RELAYER_PRIVATE_KEY — registration is public and permissionless
# and has no business borrowing a key that moves value.
# PASSPORT_SCHEMA_REGISTRAR_KEY=a_throwaway_testnet_key
#
# Signs the verification receipts GET /passport/verify hands merchants (#974).
# Its ADDRESS is published at GET /passport/issuer for merchants to pin, and
# receipts verify offline against it — so this key signs public assertions and
# must be dedicated. Never reuse RELAYER_PRIVATE_KEY: that key pays gas for
# user-authorised transactions and has no business in a public, permissionless
# signing role. Unset means verification is off and the endpoints 503 rather
# than serving an unsigned receipt.
#
# Independent of the schema UID above: set the UID without this and the
# deployment anchors real passports NO MERCHANT CAN VERIFY. GET /health's
# `passport` block reports that state and boot logs one warning naming the chain.
# Full operator procedure (key generation, per-environment setup, smoke check):
# docs/operations/passport-verification-setup.md
# PASSPORT_RECEIPT_SIGNING_KEY=a_dedicated_receipt_signing_key
# Per-chain relayer override (#640/#678): RELAYER_PRIVATE_KEY_<chainId> submits
# Safe deploys / exec / allowance transfers on that chain, falling back to the key
# above. Lets a multichain backend run an isolated, testnet-only Base Sepolia
# relayer separate from the mainnet one (prod).
# RELAYER_PRIVATE_KEY_84532=a_dedicated_testnet_only_relayer_key

# x402 binding signer. The backend signs x402 expected-context with this
# dedicated key; the edge signer verifies against its address before signing an
# x402 funding hash. Unset → x402 binding is disabled (the field is omitted from
# the connection-setup response). For deployments that hold only the public
# address, set HAVEN_X402_BINDING_SIGNER to that address instead of the key.
# X402_BINDING_PRIVATE_KEY=your_x402_binding_private_key
# HAVEN_X402_BINDING_SIGNER=0x_binding_signer_address

# Sweep dust floor in USDC (#700). The gasless delegate sweep recovers a stranded
# balance only when it's at least this much; smaller "dust" is left on the delegate
# because the relayer gas to sweep it would exceed the value returned. Default 1.
# Set to 0 to sweep any non-zero stranded balance (dev/QA does this).
# SWEEP_MIN_USDC=1

# Delegate balance monitor (#714): WARN when the total below-floor dust summed
# across all delegates passes this many USDC. Default 25.
# DELEGATE_DUST_ALERT_USDC=25
# Optional webhook (#777) for real alerting on lingering balances + dust
# breaches (Slack-compatible {text} payload). UNSET = log-only. Edge-triggered
# (no per-scan spam); best-effort (a failed post never affects the scan).
# DELEGATE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Fortnox bookkeeping integration (optional — disabled unless all three are set)
# Register an app at https://developer.fortnox.se and request the Bookkeeping scope.
# FORTNOX_REDIRECT_URI must match the redirect registered there (the backend
# callback, e.g. https://your-backend/accounting/fortnox/callback).
FORTNOX_CLIENT_ID=your_fortnox_client_id
FORTNOX_CLIENT_SECRET=your_fortnox_client_secret
FORTNOX_REDIRECT_URI=https://your-backend/accounting/fortnox/callback

# Merchant-catalog auto-discovery from the x402 Bazaar (#473). Off by default;
# set to "true" to let the hourly catalog job pull candidates from the Bazaar
# and probe-verify them before listing. CATALOG_DISCOVERY_URL is optional.
CATALOG_DISCOVERY_ENABLED=false
# CATALOG_DISCOVERY_URL=https://api.cdp.coinbase.com/platform/v2/x402/discovery/resources

# SECRET — HMAC key behind the self-service catalogue domain-ownership proof
# (epic #1717, #1712). A merchant proves they control a domain by publishing a
# value derived from this key; anyone holding it can forge a proof for ANY
# domain, so treat it exactly like JWT_SECRET: high entropy, per-environment,
# never committed, never logged. Generate with `openssl rand -base64 48`.
# UNSET is safe by design and fails CLOSED — verification refuses every claim
# with `not_configured`, so no domain can reach `ownership_verified`. There is
# deliberately no default: a derived fallback would let a deployment believe it
# was verifying domains while emitting proofs an attacker could compute.
# Rotating it invalidates every outstanding, unverified claim (already-verified
# rows keep their recorded `verified_at`); re-issue tokens after a rotation.
# CATALOG_OWNERSHIP_SECRET=

# Platform fee module (#386). Dark by default — leave unset/false. When false
# the per-transaction fee is always zero and no funds move.
HAVEN_FEE_ENABLED=false

# Legacy asserting bookkeeping (epic #462). Dark by default — superseded by the
# non-asserting reporting feed (#491). Leave false to keep SIE export + finished
# voucher push gated off.
HAVEN_LEGACY_BOOKKEEPING_ENABLED=false

# Reporting feed (epic #491) — hosted-only paid add-on. Inert unless ALL hold:
# HAVEN_HOSTED=true (managed deployment), this flag on, and the account has the
# 'reporting_feed' entitlement. Env alone can never enable it on a self-host.
HAVEN_HOSTED=false
HAVEN_REPORTING_FEED_ENABLED=false

# Agent testing — fill these in after creating an agent in the Haven dashboard
AGENT_API_KEY=sk_agent_your_key_from_dashboard
DELEGATE_PRIVATE_KEY=your_delegate_private_key
PAYMENT_TO=0x_recipient_address

# Claude agent demo (optional — only needed for npm run agent:demo)
ANTHROPIC_API_KEY=sk-ant-your_key_from_console.anthropic.com

# #1670: trusted proxy hops in front of the backend. Railway terminates in one
# edge proxy, so set 1 there; leave unset (0) for direct/local serving. This is
# what arms the per-IP auth rate limits — they deliberately stay OFF while the
# proxy is untrusted, because a shared-bucket limit on signup/login is a global
# denial-of-service, not a protection. A hop COUNT, never `true`: see config.ts.
# Operator-owned; never flipped by an agent. Before flipping in a NEW
# environment, verify the hop count empirically: log request.ip together with
# the raw x-forwarded-for header for a few real requests — with the right
# count, request.ip is the CLIENT, not an intermediate proxy.
TRUST_PROXY_HOPS=1

# #1690: emit the payer identity in x402 expected contexts (version 3). SIGNER-
# FIRST rollout: leave unset until the connector population runs a signer that
# supports context version 3 — a v1/v2 signer refuses v3 with the version-skew
# message, which is honest but blocks payments. Operator-owned; never flipped
# by an agent. When unset the wire is byte-identical to pre-#1690 (version 2).
# NOTE: read per call, so a mid-rollout flip can make two fetches of the SAME
# payment disagree on context version (authorize v3, sign-context v2) — flip
# between payments, not during one.
# X402_EMIT_PAYER_CONTEXT=1
