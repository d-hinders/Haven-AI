{
  "name": "haven",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "build": "npm run build -w packages/core && npm run build -w packages/sdk && npm run build -w packages/connect && npm run build -w packages/mcp && npm run build -w packages/mcp-server && npm run build -w packages/signer && npm run build -w packages/cli && npm run build -w packages/backend && npm run build -w packages/frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "quality": "npm run typecheck && npm run test:unit && npm run build",
    "skills:check": "node scripts/install-agent-skills.mjs --check",
    "skills:install": "node scripts/install-agent-skills.mjs",
    "test:e2e": "npm run test:e2e -w packages/frontend",
    "release:bump": "node scripts/release-bump.mjs",
    "docs:check": "node scripts/docs/validate-frontmatter.mjs && node scripts/docs/validate-agent-skills.mjs",
    "docs:new": "node scripts/docs/new-doc.mjs",
    "docs:coupling": "node scripts/docs/coupling-gate.mjs --strict --out=/dev/null",
    "docs:test": "node --test scripts/docs/*.test.mjs",
    "lint:copy": "node scripts/frontend-copy-lint.mjs",
    "lint:copy:update": "node scripts/frontend-copy-lint.mjs --update",
    "lint:copy:test": "node --test scripts/frontend-copy-lint.test.mjs",
    "lint:db-mocks": "node scripts/db-mock-ratchet.mjs",
    "lint:wire-types": "node scripts/lint-wire-types.mjs",
    "lint:network-pins": "node --test scripts/network-map-pins.test.mjs",
    "lint:wire-types:update": "node scripts/lint-wire-types.mjs --update",
    "lint:wire-types:test": "node --test scripts/lint-wire-types.test.mjs",
    "lint:db-mocks:test": "node --test scripts/db-mock-ratchet.test.mjs",
    "lint:deps": "node scripts/dep-lint.mjs",
    "lint:deps:test": "node --test scripts/dep-lint.test.mjs",
    "lint:workspace-pins": "node scripts/workspace-pin-lint.mjs",
    "lint:workspace-pins:test": "node --test scripts/workspace-pin-lint.test.mjs",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:api-types": "node scripts/generate-api-types.mjs --check",
    "check:dist": "node scripts/check-dist-freshness.mjs sdk signer mcp"
  },
  "overrides": {
    "axios": "^1.16.1",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "hono": "^4.12.23",
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "dependency-cruiser": "^18.1.0",
    "openapi-typescript": "^7.13.0"
  }
}
