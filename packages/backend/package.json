    "pilot:delegation-rail-smoke": "tsx scripts/delegation-rail-smoke.ts",
    "pilot:delegation-payment-smoke": "tsx scripts/delegation-payment-smoke.ts",
    "pilot:exit-proof": "tsx scripts/exit-acceptance-proof.ts",
    "pilot:dod": "tsx scripts/delegation-dod-matrix.ts",
    "pilot:passkey-spike": "tsx scripts/passkey-hybrid-spike.ts",
    "pilot:passkey-dod": "tsx scripts/passkey-dod-matrix.ts",
    "ops:check-bundler": "tsx scripts/check-bundler.ts",
    "ops:check-delegation": "tsx scripts/check-delegation-contracts.ts",
    "ops:check-delegate-balances": "tsx scripts/check-delegate-balances.ts",
    "db:schema-smoke": "tsx scripts/db-schema-smoke.ts",
