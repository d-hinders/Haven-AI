    "@haven_ai/core": "*",
    "@haven_ai/sdk": "*",
    "@metamask/smart-accounts-kit": "^1.6.0",
    "@rhinestone/module-sdk": "^0.4.0",
    "@safe-global/protocol-kit": "^5.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.0",
    "ethereum-cryptography": "^2.2.1",
    "ethers": "^6.13.0",
    "fastify": "^5.8.5",
    "permissionless": "^0.3.6",
    "pg": "^8.13.0",
    "viem": "^2.54.1"
