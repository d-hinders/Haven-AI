# Required: Base wallet address that receives USDC payments
MERCHANT_ADDRESS=0xYOUR_MERCHANT_ADDRESS

# Public URL where this service is deployed (used in 402 responses + invoice resource URLs).
# Hosted dev/prod deployments must use their public origin, never localhost.
# Dev/Base Sepolia: https://demo-merchant-dev-84e4.up.railway.app
# Prod/Base mainnet: https://enthusiastic-blessing-production-171f.up.railway.app
BASE_URL=https://your-demo-merchant.railway.app

# HTTP port (Railway sets this automatically)
PORT=3456

# Chain selection: 8453 = Base mainnet (default), 84532 = Base Sepolia testnet
# MERCHANT_CHAIN_ID=84532

# Settlement methods advertised by the demo merchant. Omit to advertise both.
# The default quoted method is erc7710 when it is enabled. Set eip3009 for a
# local-only or fallback merchant that should not require ERC-7710 config.
MERCHANT_X402_SETTLEMENT_METHODS=erc7710,eip3009

# Required when erc7710 is enabled: the ONLY DelegationManager contract this
# merchant trusts on the configured chain. The payload's delegationManager is
# attacker-supplied, so payments naming any other contract are rejected before
# simulation. The SETTLEMENT_PRIVATE_KEY account is the redeemer: delegations
# with a redeemer caveat must name it.
# MERCHANT_ERC7710_DELEGATION_MANAGER=0xYOUR_TRUSTED_DELEGATION_MANAGER
