# Required: Base wallet address that receives USDC payments
MERCHANT_ADDRESS=0xYOUR_MERCHANT_ADDRESS

# Public URL where this service is deployed (used in 402 responses + invoice resource URLs).
# Hosted dev/prod deployments must use their public origin, never localhost.
# Dev/Base Sepolia: https://demo-merchant-dev-84e4.up.railway.app
# Prod/Base mainnet: https://enthusiastic-blessing-production-171f.up.railway.app
BASE_URL=https://your-demo-merchant.railway.app

# HTTP port (Railway sets this automatically)
PORT=3456

# Chain selection: 8453 = Base mainnet (default), 84532 = Base Sepolia testnet
# MERCHANT_CHAIN_ID=84532

# Settlement methods advertised by the demo merchant. Omit to advertise both.
# The default quoted method is erc7710 when it is enabled. Set eip3009 for a
# local-only or fallback merchant that should not require ERC-7710 config.
MERCHANT_X402_SETTLEMENT_METHODS=erc7710,eip3009

# Required when erc7710 is enabled: the ONLY DelegationManager contract this
# merchant trusts on the configured chain. The payload's delegationManager is
# attacker-supplied, so payments naming any other contract are rejected before
# simulation. The SETTLEMENT_PRIVATE_KEY account is the redeemer: delegations
# with a redeemer caveat must name it.
# MERCHANT_ERC7710_DELEGATION_MANAGER=0xYOUR_TRUSTED_DELEGATION_MANAGER

# Agent Passport check (#4723), advisory. BOTH must be set; with either missing
# the merchant advertises only `haven-demo` and reports `passport: null`.
# MERCHANT_HAVEN_BASE_URL is the Haven API origin to resolve passports against;
# MERCHANT_PASSPORT_ISSUER is the address from GET /passport/issuer on that
# deployment, pinned once. Rotating PASSPORT_RECEIPT_SIGNING_KEY breaks the pin.
# MERCHANT_HAVEN_BASE_URL=https://api.haven.dev
# MERCHANT_PASSPORT_ISSUER=0xYOUR_PINNED_ISSUER_ADDRESS

# Coinbase's hosted x402 facilitator (CDP), #4851. BOTH must be set. With
# neither, the joke product is not offered; with only one, the merchant also
# warns. Either way every other product is unaffected. The joke (0.01 USDC, EIP-3009 only) is the
# only product CDP verifies and settles; the rest stay on SETTLEMENT_PRIVATE_KEY.
# Use a CDP secret API key (Live mode) used only by this merchant, with no
# Trade/Transfer/Receive/Export/Manage permission: the portal has no projects,
# so the key belongs to the whole account. Settings: docs/operations/railway-services.md.
# Put the real values straight into the hosting provider's service variables,
# never in a file.
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Stripe machine payments (#4853). BOTH must be set, CDP must be configured,
# and the joke's price must be a whole number of cents (it is: 0.01 USDC = one
# cent). With either missing, or CDP off, or an unusable price, the merchant
# warns and the joke keeps MERCHANT_ADDRESS; it never refuses to start.
# STRIPE_DEPOSIT_ADDRESS is the address from POST /v1/crypto/deposit_addresses
# (network=base) — the joke's receiving address while Stripe is on.
# STRIPE_SECRET_KEY is a restricted key that can create PaymentIntents AND read
# PaymentIntents (the "already recorded" lookup searches them). Sandbox values
# on dev only (Base Sepolia, API version 2026-07-29.preview). Production sets
# neither: Stripe is dev and sandbox only (owner decision 2026-11-17, #4858
# not planned), so the production joke keeps MERCHANT_ADDRESS.
# Put the real values straight into the hosting provider's service variables,
# never in a file.
# STRIPE_DEPOSIT_ADDRESS=0xYOUR_STRIPE_DEPOSIT_ADDRESS
# STRIPE_SECRET_KEY=sk_test_your_restricted_key
#
# Optional, for ONE deploy after you change STRIPE_DEPOSIT_ADDRESS: the address
# you are replacing. A payment that already settled to it is still served (the
# buyer's money moved), instead of being refused by the quote check. Remove it
# once no quote from the old address can still be paid. Never set it to an
# address this merchant did not quote: the payment's own payTo is
# attacker-chosen, so honouring it would hand goods to anyone who paid an
# address of their own.
# STRIPE_PREVIOUS_DEPOSIT_ADDRESS=0xTHE_ADDRESS_YOU_ARE_REPLACING

# Optional (#4866): the widest eth_getLogs block range your RPC serves. The
# Coinbase recovery search and the Stripe reconciliation script read the chain
# in windows of at most 500 blocks, narrowed to what the provider names when it
# refuses (the public Base Sepolia RPC serves 200). Set this only to skip that
# one refused call; it never widens the window past 500. The backend reads the
# same name (#4012), but each service has its own value.
# ETH_GETLOGS_MAX_BLOCK_RANGE=200

# Optional (#4856): the seller on every receipt. With none of these set, the
# receipt carries the demo seller (Haven Demo AB), exactly as before. Set all
# four of NAME, ADDRESS, ORG_NR and MOMS_NR to carry a real seller; IBAN and
# BIC are optional and never taken from the demo seller. With any of these set
# but one of the four required ones missing (IBAN or BIC alone included), the
# merchant warns and keeps the demo seller.
# MERCHANT_SELLER_NAME=Your Company AB
# MERCHANT_SELLER_ADDRESS=Street 1, 111 11 City
# MERCHANT_SELLER_ORG_NR=000000-0000
# MERCHANT_SELLER_MOMS_NR=SE000000000001
# MERCHANT_SELLER_IBAN=
# MERCHANT_SELLER_BIC=
#
# No variable for the SEK rate (#4856): with Stripe recording on, the joke's
# receipt states an indicative USDC→SEK rate from CoinGecko's public spot price
# (api.coingecko.com), read in the background and never awaited by a purchase.
