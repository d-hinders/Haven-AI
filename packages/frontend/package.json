{
  "name": "@haven/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm --prefix ../core run build && next build",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit",
    "start": "next start",
    "lint": "next lint",
    "design:lint": "node scripts/design-lint.mjs",
    "design:lint:update": "node scripts/design-lint.mjs --update",
    "design:coupling": "node scripts/design-system-coupling.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "npm --prefix ../core run build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL_REGRESSION=1 playwright test e2e/design-system.visual.spec.ts --project=chromium-desktop",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:full": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report ../../output/playwright/html-report"
  },
  "dependencies": {
    "@haven_ai/core": "*",
    "@metamask/smart-accounts-kit": "^1.6.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@safe-global/safe-modules-deployments": "^3.0.4",
    "@tanstack/react-query": "^5.96.1",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.27",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "next": "^15.5.18",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "viem": "2.54.1",
    "wagmi": "^2.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vitest": "^3.2.4"
  }
}
