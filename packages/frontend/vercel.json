{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "ignoreCommand": "sh \"$(git rev-parse --show-toplevel)/scripts/vercel/ignore-build.sh\" FRONTEND_FORCE_BUILD scripts/vercel/watch/frontend.txt"
}
