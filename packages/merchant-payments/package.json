{
  "name": "@haven_ai/merchant-payments",
  "version": "0.0.0",
  "private": true,
  "description": "Haven merchant payment core — the receipt builder and the buyer tax-declaration check shared by the demo merchant and the paywall proxy (#4890, #4889). Not published; consumed via the npm workspace only.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm --prefix ../sdk run build && tsup",
    "test": "npm --prefix ../sdk run build && vitest run",
    "typecheck": "npm --prefix ../sdk run build && tsc --noEmit"
  },
  "keywords": [
    "haven",
    "internal"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@haven_ai/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
