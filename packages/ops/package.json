{
  "name": "@haven/ops",
  "version": "0.1.0",
  "private": true,
  "description": "Haven's private operations console. Reads through the ops backend surface (#3509); every sign-in and read is audited server-side.",
  "scripts": {
    "dev": "next dev",
    "build": "npm --prefix ../core run build && next build",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit",
    "start": "next start",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "npm --prefix ../core run build && vitest run"
  },
  "dependencies": {
    "@haven_ai/core": "*",
    "@haven_ai/ui": "*",
    "lucide-react": "^1.24.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.27",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^8.0.14",
    "vitest": "^3.2.4"
  }
}
