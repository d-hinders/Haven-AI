# The paywall proxy's settings. Copy this file to .env and fill in your own
# values. The proxy reads the process environment; it does not load a .env file
# itself. With the container image, `docker run --env-file .env` loads it. Run
# from source, export the variables or let your process manager do it.
# Every variable marked REQUIRED refuses startup when it is missing or invalid,
# and the refusal names the variable, never a secret's value.

# REQUIRED. The one network this deployment settles on, as a CAIP-2 id.
# eip155:84532 is Base Sepolia. There is no default. eip155:8453 (Base mainnet)
# is refused at startup in this release.
NETWORK=eip155:84532

# REQUIRED. The address that receives every payment: your Sales account's
# receiving address. Turn Sales on (Settings → Business), then open
# Sales → Setup → Receiving address → Show address. Every product is paid to it.
PAY_TO=0xYOUR_SALES_ACCOUNT_ADDRESS

# REQUIRED. Who operates this endpoint. The discovery document shows it.
OPERATOR_NAME=Your Company

# OPTIONAL. A URL or address a reader can use to reach you.
# OPERATOR_CONTACT=https://your-company.example/contact

# OPTIONAL. The endpoint's human name and description, shown in the discovery
# document. One line each. Defaults: the name is OPERATOR_NAME, and the
# description is a sentence built from the products file and the network.
# ENDPOINT_NAME=Your inference API
# ENDPOINT_DESCRIPTION=Your model, paid per call on Base Sepolia.

# OPTIONAL. A public image URL (JPG, PNG, WebP or GIF), for a directory listing.
# ICON_URL=https://your-company.example/icon.png

# REQUIRED. The products file: the routes you sell and their prices.
PRODUCTS_FILE=./products.json

# REQUIRED. The consumed-payment store. One proxy process per file, and the
# file is the record of which payments already bought a call: back it up.
PAYMENTS_DB=./payments.sqlite

# REQUIRED. Where paid calls are forwarded, and the key they are forwarded with.
UPSTREAM_BASE_URL=https://api.your-provider.example
UPSTREAM_API_KEY=your-upstream-api-key

# OPTIONAL. How the upstream key is sent. Defaults: Authorization / Bearer.
# Set UPSTREAM_AUTH_SCHEME to an empty value to send the key bare, for an
# upstream that wants `x-api-key: <key>`.
# UPSTREAM_AUTH_HEADER=Authorization
# UPSTREAM_AUTH_SCHEME=Bearer

# OPTIONAL. Set to `none` for an upstream that needs no key. Then leave
# UPSTREAM_API_KEY, UPSTREAM_AUTH_HEADER and UPSTREAM_AUTH_SCHEME unset: the
# proxy sends no upstream auth header. Unset, UPSTREAM_API_KEY is required.
# UPSTREAM_AUTH=none

# OPTIONAL. A cheap authenticated GET path on UPSTREAM_BASE_URL that `check`
# calls to prove the upstream key, for example /v3/compat/models. It is joined
# onto UPSTREAM_BASE_URL the way a paid call's path is, so it starts with "/"
# and carries no query string. Unset: the `upstream` line prints skipped and
# `check` reaches no upstream. A GET buys no inference call.
# UPSTREAM_CHECK_PATH=/v3/compat/models

# REQUIRED. Your own Coinbase developer (CDP) secret API key. The proxy settles
# through Coinbase's facilitator with it. Haven never supplies this key.
# Create a Secret API key at https://portal.cdp.coinbase.com/projects/api-keys
# with the signature algorithm Ed25519 (the default), mode Live, "allow requests
# from any IP address", and Trade, Transfer, Receive, Export and Manage left
# unticked. The key's ID is CDP_API_KEY_ID and its secret is CDP_API_KEY_SECRET.
# An Ed25519 secret is one base64 line, which fits this file; an ECDSA PEM is
# several lines and does not. The README's § Coinbase developer keys has the
# settings and why.
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# OPTIONAL on Base Sepolia, REQUIRED on Base mainnet. An RPC URL for the network
# above. The proxy reads the chain with it when a settle answer is lost or an
# authorization was already used. Unset on Base Sepolia, it uses the public node
# https://sepolia.base.org. Base mainnet has no default: real money would rest
# on a rate-limited public node. Base mainnet is refused at startup in this
# release, and the rule stays for go-live.
# RPC_URL=https://sepolia.base.org

# OPTIONAL. The path prefix your products' routes are matched under. Empty by
# default, so `POST /v1/chat/completions` is served at that exact path. The
# discovery document lists each route with this prefix in front, so a buyer
# calls the route as listed.
# BASE_PATH=/api

# NEEDED FOR A HAVEN BUYER. The proxy starts without it, but set it whenever the
# proxy is reached through an https front (a tunnel, your host's edge, Railway).
# It is the public origin the challenge names. Without it the proxy derives
# http://<Host>, and Haven's signer answers a retry challenge only for an https
# origin.
# PUBLIC_BASE_URL=https://pay.your-company.example

# OPTIONAL. The header your own front proxy sets to the client's address, for
# the per-IP limits. Without it every request behind a reverse proxy shares the
# reverse proxy's address.
# CLIENT_IP_HEADER=X-Forwarded-For

# OPTIONAL. Listen address. Defaults: 8080 / 0.0.0.0.
# PORT=8080
# HOST=0.0.0.0

# OPTIONAL. The whole upstream call's deadline, at most 180000 ms.
# UPSTREAM_TIMEOUT_MS=180000

# OPTIONAL. How long the request that reserved a payment is trusted to finish
# settling, at least 110000 ms.
# RESERVATION_DEADLINE_MS=120000

# OPTIONAL. The receipt. With no VAT_RULE the proxy sends no receipt and needs
# no seller detail. The merchant decides its own tax treatment: the kit applies
# the rule you configure and makes no tax decision of its own.
# The pilot has one rule, SE_25_WITH_EU_REVERSE_CHARGE: 25% Swedish VAT taken
# out of the price, and reverse charge when the buyer's accepted declaration
# names another EU country.
# VAT_RULE=SE_25_WITH_EU_REVERSE_CHARGE

# REQUIRED with VAT_RULE: your legal name, organisation number and VAT number.
# On Base mainnet the proxy refuses to start without them; on a test network it
# starts with a warning and sends no receipt. Base mainnet itself is refused at
# startup in this release, and the rule stays for go-live.
# SELLER_NAME=Your Company AB
# SELLER_ORG_NR=559123-4567
# SELLER_VAT_NR=SE559123456701

# OPTIONAL with VAT_RULE: your address and bank details, on the seller block.
# SELLER_ADDRESS=Sveavägen 10, 111 57 Stockholm
# SELLER_IBAN=SE35 5000 0000 0549 1000 0003
# SELLER_BIC=ESSESESS

# OPTIONAL with VAT_RULE: your own support contact. Never Haven's. The proxy
# sends the receipt as JSON only, and that shape carries no support line, so
# this value has no effect on the receipt the proxy emits.
# SELLER_SUPPORT_CONTACT=support@your-company.example

# OPTIONAL. Coinbase's directory listing. Off by default, and `on` is refused in
# this release: listing is later work.
# DIRECTORY_LISTING=off

# NEEDED FOR HAVEN'S PILOT; optional for a merchant that only wants to accept
# payments. Sales reporting to Haven: set HAVEN_MERCHANT_KEY and HAVEN_SALES_URL
# below (remove the # and put in your own key). With no HAVEN_MERCHANT_KEY the
# proxy reports nothing and starts exactly as without it. With the key set, reporting
# is on and the key and Haven's origin are required: a key that is not a Sales
# key, or a missing or unusable Haven origin, refuses startup.
# HAVEN_MERCHANT_KEY is your Haven Sales key (sk_merchant_...), created on
# Sales → Setup → Sales keys. It is receive-only: it authenticates the sales
# routes and nothing else. The proxy never logs it.
# HAVEN_SALES_URL is Haven's API origin; the proxy appends /merchant/sales.
# On Base Sepolia it is https://havenbackend-dev-8b95.up.railway.app
# (docs/operations/dev-environment.md).
# SALES_OUTBOX is the file records Haven has not accepted yet are kept in: one
# proxy process per file, on persistent disk, backed up with PAYMENTS_DB.
# Defaults to sales-outbox.jsonl in the same directory as PAYMENTS_DB.
# HAVEN_MERCHANT_KEY=sk_merchant_your_sales_key
# HAVEN_SALES_URL=https://havenbackend-dev-8b95.up.railway.app
# SALES_OUTBOX=./sales-outbox.jsonl
