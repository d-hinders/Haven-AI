# The paywall proxy's settings. Copy this file, fill in your own values, and
# export them into the process environment before you start the proxy. The
# proxy reads the process environment; it does not load a .env file itself.
# Every variable marked REQUIRED refuses startup when it is missing or invalid,
# and the refusal names the variable, never a secret's value.

# REQUIRED. The one network this deployment settles on, as a CAIP-2 id.
# eip155:84532 is Base Sepolia. There is no default.
NETWORK=eip155:84532

# REQUIRED. The address that receives every payment: your Haven account's
# address. Every product is paid to it.
PAY_TO=0xYOUR_HAVEN_ACCOUNT_ADDRESS

# REQUIRED. Who operates this endpoint. The discovery document shows it.
OPERATOR_NAME=Your Company

# OPTIONAL. A URL or address a reader can use to reach you.
# OPERATOR_CONTACT=https://your-company.example/contact

# REQUIRED. The endpoint's human name and description, shown in the discovery
# document. One line each.
ENDPOINT_NAME=Your inference API
ENDPOINT_DESCRIPTION=Your model, paid per call on Base Sepolia.

# OPTIONAL. A public image URL (JPG, PNG, WebP or GIF), for a directory listing.
# ICON_URL=https://your-company.example/icon.png

# REQUIRED. The products file: the routes you sell and their prices.
PRODUCTS_FILE=./products.json

# REQUIRED. The consumed-payment store. One proxy process per file, and the
# file is the record of which payments already bought a call: back it up.
PAYMENTS_DB=./payments.sqlite

# REQUIRED. Where paid calls are forwarded, and the key they are forwarded with.
UPSTREAM_BASE_URL=https://api.your-provider.example
UPSTREAM_API_KEY=your-upstream-api-key

# OPTIONAL. How the upstream key is sent. Defaults: Authorization / Bearer.
# Set UPSTREAM_AUTH_SCHEME to an empty value to send the key bare, for an
# upstream that wants `x-api-key: <key>`.
# UPSTREAM_AUTH_HEADER=Authorization
# UPSTREAM_AUTH_SCHEME=Bearer

# REQUIRED. Your own Coinbase developer (CDP) secret API key. The proxy settles
# through Coinbase's facilitator with it. Haven never supplies this key.
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# REQUIRED. An RPC URL for the network above. The proxy reads the chain with it
# when a settle answer is lost or an authorization was already used.
RPC_URL=https://sepolia.base.org

# OPTIONAL. The path prefix your products' routes are matched under. Empty by
# default, so `POST /v1/chat/completions` is served at that exact path.
# BASE_PATH=/api

# OPTIONAL. The public origin the challenge names. Must be https in production.
# Without it the proxy derives http://<Host>, and Haven's signer answers a retry
# challenge only for an https origin.
# PUBLIC_BASE_URL=https://pay.your-company.example

# OPTIONAL. The header your own front proxy sets to the client's address, for
# the per-IP limits. Without it every request behind a reverse proxy shares the
# reverse proxy's address.
# CLIENT_IP_HEADER=X-Forwarded-For

# OPTIONAL. Listen address. Defaults: 8080 / 0.0.0.0.
# PORT=8080
# HOST=0.0.0.0

# OPTIONAL. The whole upstream call's deadline, at most 180000 ms.
# UPSTREAM_TIMEOUT_MS=180000

# OPTIONAL. How long the request that reserved a payment is trusted to finish
# settling, at least 110000 ms.
# RESERVATION_DEADLINE_MS=120000

# OPTIONAL. The receipt. With no VAT_RULE the proxy sends no receipt and needs
# no seller detail. The merchant decides its own tax treatment: the kit applies
# the rule you configure and makes no tax decision of its own.
# The pilot has one rule, SE_25_WITH_EU_REVERSE_CHARGE: 25% Swedish VAT taken
# out of the price, and reverse charge when the buyer's accepted declaration
# names another EU country.
# VAT_RULE=SE_25_WITH_EU_REVERSE_CHARGE

# REQUIRED with VAT_RULE: your legal name, organisation number and VAT number.
# On Base mainnet the proxy refuses to start without them; on a test network it
# starts with a warning and sends no receipt.
# SELLER_NAME=Your Company AB
# SELLER_ORG_NR=559123-4567
# SELLER_VAT_NR=SE559123456701

# OPTIONAL with VAT_RULE: your address and bank details, on the seller block.
# SELLER_ADDRESS=Sveavägen 10, 111 57 Stockholm
# SELLER_IBAN=SE35 5000 0000 0549 1000 0003
# SELLER_BIC=ESSESESS

# OPTIONAL with VAT_RULE: your own support contact. Never Haven's. The proxy
# sends the receipt as JSON only, and that shape carries no support line, so
# this value has no effect on the receipt the proxy emits.
# SELLER_SUPPORT_CONTACT=support@your-company.example

# OPTIONAL. Coinbase's directory listing. Off by default, and `on` is refused in
# this release: listing is later work (#4887).
# DIRECTORY_LISTING=off

# OPTIONAL. Sales reporting to Haven. With no HAVEN_MERCHANT_KEY the proxy
# reports nothing and starts exactly as without it. With the key set, reporting
# is on and all three settings are required: a key that is not a Sales key, a
# missing or unusable Haven origin, or no outbox file refuses startup.
# HAVEN_MERCHANT_KEY is your Haven Sales key (sk_merchant_...), receive-only: it
# authenticates the sales routes and nothing else. The proxy never logs it.
# HAVEN_SALES_URL is Haven's API origin; the proxy appends /merchant/sales.
# SALES_OUTBOX is the file records Haven has not accepted yet are kept in: one
# proxy process per file, on persistent disk, backed up with PAYMENTS_DB.
# HAVEN_MERCHANT_KEY=sk_merchant_your_sales_key
# HAVEN_SALES_URL=https://api.haven.example
# SALES_OUTBOX=./sales-outbox.jsonl
